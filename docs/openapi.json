{
  "openapi": "3.1.0",
  "info": {
    "title": "NakiLiveTranscode experimental control API",
    "version": "0.9.0",
    "description": "Current implemented API only. Linux, one active job. No authentication. This static document is not served by the application. URI matching is exact (query strings and trailing slashes are not supported). Media errors after acceptance appear in job state=failed, not in a later HTTP response. Unknown and duplicate configuration keys are rejected. Request limit 16384 bytes, header limit 8192 bytes, HTTP timeout 10s. Libevent framing/limit errors and allocation failures can return HTML instead of the application JSON error envelope. Future pipeline-design.md fields are not accepted."
  },
  "servers": [{"url": "http://127.0.0.1:8090"}],
  "security": [],
  "paths": {
    "/v1/jobs": {
      "post": {
        "operationId": "createJobOperation",
        "summary": "Create or retry one normalized creation intent in the fixed service namespace",
        "description": "202 follows worker ownership ACK. Retry the same operation_id after an uncertain 503 or connection loss. Identical normalized spec returns the original job before busy admission; conflicting intent returns 409. Finite in-memory retention, not durable acceptance.",
        "requestBody": {"required": true, "content": {"application/json": {"schema": {"type": "object", "additionalProperties": false, "required": ["operation_id", "spec"], "properties": {"operation_id": {"$ref": "#/components/schemas/ControlId"}, "spec": {"$ref": "#/components/schemas/JobConfig"}}}}}},
        "responses": {"202": {"description": "Worker accepted, or retained original acceptance; job_id identifies the same owner."}, "409": {"$ref": "#/components/responses/Error"}, "503": {"description": "Unresolved recovery, capacity, shutdown or uncertain ownership; reuse the same operation_id."}, "default": {"$ref": "#/components/responses/Error"}}
      }
    },
    "/v1/jobs/{job_id}": {
      "parameters": [{"$ref": "#/components/parameters/JobId"}],
      "get": {"operationId": "getTargetJob", "responses": {"200": {"$ref": "#/components/responses/Status"}, "404": {"$ref": "#/components/responses/Error"}}}
    },
    "/v1/jobs/{job_id}/stop": {
      "parameters": [{"$ref": "#/components/parameters/JobId"}],
      "post": {
        "operationId": "stopTargetJob", "description": "Reserve one stop operation per job. Duplicate accepted operation replays before current-job admission checks. 202 follows worker stop-intent ACK; query state separately. New stale-target stop cannot affect a replacement job.",
        "requestBody": {"required": true, "content": {"application/json": {"schema": {"type": "object", "additionalProperties": false, "required": ["operation_id"], "properties": {"operation_id": {"$ref": "#/components/schemas/ControlId"}}}}}},
        "responses": {"202": {"description": "Known worker stop intent or retained stop result."}, "409": {"$ref": "#/components/responses/Error"}, "503": {"description": "Stop acknowledgement unconfirmed; query/retry original operation."}, "default": {"$ref": "#/components/responses/Error"}}
      }
    },
    "/v1/jobs/{job_id}/operations/{operation_id}": {
      "parameters": [{"$ref": "#/components/parameters/JobId"}, {"name": "operation_id", "in": "path", "required": true, "schema": {"$ref": "#/components/schemas/ControlId"}}],
      "get": {"operationId": "getRetainedOperation", "description": "Worker-authoritative create/update/stop query, or bounded controller history. A 200 response can have outcome_known=false, state=unknown, reason=operation_outcome_unknown and last_observed after unconfirmed worker loss. Cached pending never proves not_written. See component-updates.md.", "responses": {"200": {"description": "Authoritative or explicitly unknown result.", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/OperationResult"}}}}, "404": {"$ref": "#/components/responses/Error"}, "429": {"$ref": "#/components/responses/Error"}, "503": {"$ref": "#/components/responses/Error"}}}
    },
    "/v1/jobs/{job_id}/updates": {
      "parameters": [{"$ref": "#/components/parameters/JobId"}],
      "post": {
        "operationId": "updateTargetComponent", "summary": "Typed sparse watermark update with worker CAS and caller operation ID",
        "description": "8192-byte envelope. Matching original intent replays before closing/CAS/budget checks. Omitted fields retain desired; null, unknown/duplicate keys and policy fields are rejected. Prepare failure retains failed desired and previous effective. Per-output revisions, shared per-job create/update/stop ID domain. 256 update records/2MiB worker store plus reserved stop; completed results retained at least 30 minutes, referenced records pinned. One outstanding update/query RPC, 2s acknowledgement wait. Bounded memory, not a durable journal.",
        "requestBody": {"required": true, "content": {"application/json": {"schema": {"$ref": "#/components/schemas/ComponentUpdate"}}}},
        "responses": {"202": {"description": "Worker accepted or matching operation active.", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/OperationResult"}}}}, "200": {"description": "Matching terminal result.", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/OperationResult"}}}}, "400": {"$ref": "#/components/responses/Error"}, "404": {"$ref": "#/components/responses/Error"}, "409": {"$ref": "#/components/responses/Error"}, "429": {"$ref": "#/components/responses/Error"}, "503": {"$ref": "#/components/responses/Error"}}
      }
    },
    "/health/live": {"get": {"operationId": "getControllerLiveness", "description": "HTTP event-loop liveness, independent of media output.", "responses": {"200": {"description": "Controller can answer."}, "405": {"$ref": "#/components/responses/Error"}}}},
    "/health/ready": {"get": {"operationId": "getControlReadiness", "description": "Reliable ownership/control management. Healthy busy remains ready; recovery/unavailable/stale control closes readiness. No new automatic kill threshold.", "responses": {"200": {"description": "Control ready."}, "503": {"description": "Explicit readiness reason in body."}, "405": {"$ref": "#/components/responses/Error"}}}},
    "/health/admission": {"get": {"operationId": "getCreationAdmission", "description": "New creation eligibility; busy/recovery/retention/worker/backoff reasons are distinct from readiness.", "responses": {"200": {"description": "New creation may be attempted."}, "503": {"description": "Admission closed with reason."}, "405": {"$ref": "#/components/responses/Error"}}}},
    "/health": {
      "get": {
        "operationId": "getHealth",
        "summary": "Controller health, build capabilities and worker pool",
        "responses": {"200": {"description": "Controller is reachable; inspect status and pool separately from media progress.", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/Health"}}}}, "default": {"$ref": "#/components/responses/Error"}}
      }
    },
    "/v1/job": {
      "get": {
        "operationId": "getJob",
        "summary": "Current job or last job; idle before any job",
        "responses": {"200": {"$ref": "#/components/responses/Status"}, "default": {"$ref": "#/components/responses/Error"}}
      },
      "post": {
        "operationId": "startJob",
        "summary": "Start the single media job asynchronously",
        "parameters": [{"in": "header", "name": "X-Request-ID", "required": false, "schema": {"$ref": "#/components/schemas/ControlId"}, "description": "HTTP-attempt correlation, not a business retry key. Missing values receive a random 128-bit ID; invalid values return 400."}],
        "requestBody": {"required": true, "content": {"application/json": {"schema": {"$ref": "#/components/schemas/JobConfig"}, "examples": {
          "srtVvc": {"value": {"input": "srt://0.0.0.0:15000?mode=listener&latency=50000", "output": "srt://receiver.example:15000?mode=caller&latency=50000", "output_format": "mpegts", "encoder": "libvvenc", "audio_copy": true, "mux_wait_ms": 50}},
          "rtmpVvc": {"value": {"input": "rtmp://source.example/live/input", "output": "rtmp://receiver.example/live/output", "output_format": "flv", "encoder": "libvvenc"}}
        }}}},
        "responses": {
          "202": {"$ref": "#/components/responses/Status"},
          "400": {"description": "Invalid JSON, fields, ranges or cross-field combination.", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/Error"}}}},
          "409": {"description": "A job is already active.", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/Error"}}}},
          "413": {"description": "Empty body or request body exceeds 16384 bytes. Libevent may return text/html."},
          "503": {"description": "Shutting down, recovering workers, recovery conflict or no available worker. Retry after recovery; no Retry-After header is promised.", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/Error"}}}},
          "default": {"$ref": "#/components/responses/Error"}
        }
      }
    },
    "/v1/job/watermark": {
      "post": {
        "operationId": "replaceWatermark",
        "summary": "Prepare and atomically replace the single watermark",
        "description": "Full replacement. Revision must equal worker accepted_revision+1; initial revision=1. 202 acknowledges worker acceptance, not preparation/application. Poll watermark status. 2s ACK timeout returns 503 with uncertain outcome; inspect worker revision before retrying. Required cannot be disabled; startup.required immutable. Body 1..8192 bytes.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/WatermarkUpdate"
              }
            }
          }
        },
        "responses": {
          "202": {
            "description": "Worker accepted candidate; inspect preparation/application separately."
          },
          "400": {
            "$ref": "#/components/responses/Error"
          },
          "409": {
            "description": "Revision conflict, immutable required policy, no active assigned worker, pending ACK, or unsupported video canvas."
          },
          "413": {
            "description": "Empty or over 8192 bytes."
          },
          "503": {
            "description": "Worker unavailable, shutdown, or uncertain ACK timeout; inspect accepted revision."
          }
        }
      }
    }
,
    "/v1/job/stop": {
      "post": {
        "operationId": "stopJob",
        "summary": "Request cancellation; poll until stopped or failed",
        "description": "Legacy adapter requires explicit job_id; optional operation_id enables retained retries. CLI resolves current once then binds that ID. 202 accepts controller stop intent; use the new targeted route for worker-ACK acceptance. In-flight reordered frames may be omitted.",
        "requestBody": {"required": true, "content": {"application/json": {"schema": {"type": "object", "additionalProperties": false, "required": ["job_id"], "properties": {"job_id": {"$ref": "#/components/schemas/ControlId"}, "operation_id": {"$ref": "#/components/schemas/ControlId"}}}}}},
        "responses": {"202": {"$ref": "#/components/responses/Status"}, "409": {"$ref": "#/components/responses/Error"}, "default": {"$ref": "#/components/responses/Error"}}
      }
    }
  },
  "components": {
    "parameters": {"JobId": {"name": "job_id", "in": "path", "required": true, "schema": {"type": "string", "minLength": 1, "maxLength": 63, "pattern": "^[A-Za-z0-9_-]+$"}}},
    "responses": {
      "Status": {"description": "Asynchronous job snapshot. Worker fields can be absent until the first snapshot. Retains last job after completion. No-store.", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/JobStatus"}}}},
      "Error": {"description": "Application JSON error (400/404/405/409/413/429/500/503 as applicable). Unknown URI=404; legacy exact known URI with wrong method=405. Libevent or allocation failures may return HTML.", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/Error"}}, "text/html": {"schema": {"type": "string"}}}}
    },
    "schemas": {
      "ControlId": {"type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[A-Za-z0-9_-]+$"},
      "ComponentUpdate": {
        "type": "object", "additionalProperties": false, "required": ["operation_id", "target", "expected_revision", "patch"],
        "properties": {
          "operation_id": {"$ref": "#/components/schemas/ControlId"},
          "target": {"type": "object", "additionalProperties": false, "required": ["output_id", "component"], "properties": {"output_id": {"type": "string", "minLength": 1, "maxLength": 32, "pattern": "^[A-Za-z0-9_-]+$"}, "component": {"const": "watermark"}}},
          "expected_revision": {"type": "integer", "minimum": 1, "maximum": 9223372036854775806},
          "patch": {"$ref": "#/components/schemas/WatermarkPatch"}
        }
      },
      "WatermarkPatch": {
        "type": "object", "additionalProperties": false, "description": "Sparse typed fields; omission retains desired, null rejected. Startup/update/animation policies and encoder/output fields are immutable.",
        "properties": {
          "enabled": {"type": "boolean"},
          "resource": {"type": "object", "additionalProperties": false, "properties": {"uri": {"type": "string", "minLength": 1, "maxLength": 2047}, "load_timeout_ms": {"type": "integer", "minimum": 1, "maximum": 30000}}},
          "placement": {"type": "object", "additionalProperties": false, "properties": {
            "anchor": {"enum": ["top_left", "top_center", "top_right", "center_left", "center", "center_right", "bottom_left", "bottom_center", "bottom_right"]},
            "opacity": {"type": "number", "minimum": 0, "maximum": 1},
            "offset": {"type": "object", "additionalProperties": false, "properties": {"x": {"type": "integer", "minimum": -8192, "maximum": 8192}, "y": {"type": "integer", "minimum": -8192, "maximum": 8192}}},
            "size": {"type": "object", "additionalProperties": false, "properties": {"width": {"type": "integer", "minimum": 1, "maximum": 2048}, "height": {"type": "integer", "minimum": 1, "maximum": 2048}, "fit": {"enum": ["contain", "stretch"]}}}
          }}
        }
      },
      "FrameCheckpoint": {"type": "object", "properties": {"frame_id": {"type": "integer", "minimum": 1}, "source_pts": {"type": "integer"}, "source_us": {"type": "integer"}, "source_tb_num": {"type": "integer", "minimum": 1}, "source_tb_den": {"type": "integer", "minimum": 1}, "output_pts": {"type": "integer"}, "output_tb_num": {"type": "integer", "minimum": 1}, "output_tb_den": {"type": "integer", "minimum": 1}}},
      "OperationResult": {
        "type": "object", "required": ["job_id", "operation_id", "kind", "state", "outcome_known"], "additionalProperties": true,
        "description": "applied and first_written may identify different frames. first_written is local write/flush, not display. Unknown outcome retains last_observed and confirmed checkpoints; pending history is never presented as current execution.",
        "properties": {
          "job_id": {"type": "string"}, "operation_id": {"$ref": "#/components/schemas/ControlId"}, "kind": {"enum": ["create", "update", "stop"]},
          "origin_request_id": {"$ref": "#/components/schemas/ControlId"}, "operation_url": {"type": "string"},
          "state": {"enum": ["reserved", "accepted", "preparing", "prepared", "applying", "applied", "failed", "superseded", "cancelled", "stopping", "stopped", "unknown"]},
          "outcome_known": {"type": "boolean"}, "reason": {"type": "string"}, "accepted_revision": {"type": "integer"},
          "result_source": {"enum": ["worker", "controller_history"]}, "result_expires_at": {"type": ["string", "null"]}, "result_expires_monotonic_us": {"type": ["integer", "null"]},
          "result_version": {"type": "integer", "minimum": 1, "description": "Worker-store mutation sequence scoped to this job. Covers all result fields, including lease and retention changes after delivery. Controllers retain the entire greatest-version result despite message reordering."},
          "applied_checkpoint": {"oneOf": [{"$ref": "#/components/schemas/FrameCheckpoint"}, {"type": "null"}]},
          "delivery": {"type": "object", "properties": {"state": {"enum": ["not_ready", "pending", "first_written", "not_written"]}, "inflight_frame_leases": {"type": "integer", "minimum": 0}, "first_written": {"oneOf": [{"$ref": "#/components/schemas/FrameCheckpoint"}, {"type": "null"}]}, "written_us": {"type": "integer"}}},
          "last_observed": {"type": ["object", "null"]}
        }
      },
      "Components": {"type": "object", "properties": {"watermark": {"type": "object", "properties": {"state": {"type": "string"}, "desired_revision": {"type": "integer"}, "effective_revision": {"type": "integer"}, "claimed_revision": {"type": "integer"}, "desired": {"$ref": "#/components/schemas/Watermark"}, "effective": {"oneOf": [{"$ref": "#/components/schemas/Watermark"}, {"type": "null"}]}}}}},
      "JobConfig": {
        "type": "object", "additionalProperties": false, "required": ["input"], "oneOf": [{"required":["output"],"not":{"required":["outputs"]}},{"required":["outputs"],"not":{"anyOf":[{"required":["output"]},{"required":["watermark"]}]}}],
        "description": "UTF-8 strings must fit C buffers in bytes, exclude NUL. At most 32 keys; duplicates rejected before schema validation. min_threads<=max_threads. width/height are both zero/omitted or both positive even values. RTMP output requires flv; SRT requires mpegts. pace=true requires a local input. Encoder preset/profile must match the selected encoder; defaults are conditional.",
        "properties": {
          "input": {"type": "string", "minLength": 1, "maxLength": 2047, "description": "Local path or enabled FFmpeg input URL; maximum 2047 bytes. Video H.264/HEVC only."},
          "output": {"type": "string", "minLength": 1, "maxLength": 2047, "description": "New local path (exclusive create), or udp://, tcp://, rtmp://, srt://, http:// URL. Parent directory must exist; maximum 2047 bytes."},
          "output_format": {"type": "string", "enum": ["mpegts", "mp4", "flv"], "default": "mpegts"},
          "encoder": {"type": "string", "enum": ["libx264", "libvvenc"], "default": "libx264"},
          "encoder_preset": {"type": "string", "enum": ["ultrafast", "superfast", "veryfast", "faster", "fast", "medium", "slow", "slower", "veryslow"], "description": "x264 defaults to veryfast; VVenC defaults to faster and only accepts faster/fast/medium/slow/slower."},
          "encoder_profile": {"type": "string", "enum": ["default", "reference", "live_3b_2s", "live_3b_2s_no_mctf"], "description": "x264 only default. VVenC defaults to live_3b_2s, also accepts reference/live_3b_2s_no_mctf. Live profiles use a PTS-anchored 2s CRA grid, full 3B groups and shorter boundary/tail groups."},
          "width": {"type": "integer", "minimum": 0, "maximum": 8192, "multipleOf": 2, "default": 0},
          "height": {"type": "integer", "minimum": 0, "maximum": 8192, "multipleOf": 2, "default": 0},
          "bitrate": {"type": "integer", "minimum": 10000, "maximum": 100000000, "default": 1500000, "description": "Video bits per second."},
          "max_threads": {"type": "integer", "minimum": 2, "maximum": 64, "default": 12},
          "min_threads": {"type": "integer", "minimum": 1, "maximum": 64, "default": 2},
          "budget_slots": {"type": "integer", "minimum": 1, "maximum": 256, "default": 12, "description": "Adaptive decoder budget, not an overall CPU quota."},
          "queue_capacity": {"type": "integer", "minimum": 1, "maximum": 64, "default": 4, "description": "Async decoder queue; independent from reader and mux queues."},
          "encoder_threads": {"type": "integer", "minimum": 1, "maximum": 16, "default": 2},
          "fps": {"type": "integer", "minimum": 1, "maximum": 240, "default": 25, "description": "Used only when av_guess_frame_rate is unavailable. Effective rational rate drives encoder/RC hints, nominal GOP frame count and queue work charge; source PTS cadence is preserved. See video-rate.md."},
          "pace": {"type": "boolean", "default": false, "description": "Local input file DTS-paced replay."},
          "frame_log": {"type": "boolean", "default": false},
          "frame_log_every": {"type": "integer", "minimum": 1, "maximum": 1000000, "default": 1, "description": "Detail sampling only; metrics still count every written video frame. I/key/slow frames override sampling."},
          "slow_frame_ms": {"type": "integer", "minimum": 1, "maximum": 600000, "default": 200},
          "audio_copy": {"type": "boolean", "default": true, "description": "Bounded AAC/MP3 passthrough for FLV/TS; MP4 always video-only. No audio encoding."},
          "mux_wait_ms": {"type": "integer", "minimum": 1, "maximum": 1000, "default": 50, "description": "FLV/TS monotonic wall interleaving wait; polled every 10ms. Excludes encode, scheduling stalls and blocking network I/O."},
          "timestamps": {"$ref": "#/components/schemas/TimestampPolicy"},
          "intra": {"$ref": "#/components/schemas/IntraPolicy"},
          "frame_selection": {"$ref": "#/components/schemas/FrameSelection"},
          "watermark": {"$ref": "#/components/schemas/Watermark"},
          "sei": {"$ref": "#/components/schemas/SeiPolicy"},
          "outputs": {"type":"array","minItems":1,"maxItems":4,"items":{"$ref":"#/components/schemas/OutputConfig"},"allOf":[{"if":{"minItems":2},"then":{"items":{"required":["id"]}}}],"description":"One logical output retains the direct execution path and defaults id to main; arrays with two to four entries require explicit unique ids."}
        },
        "allOf": [
          {"if": {"required": ["intra"]}, "then": {"required": ["timestamps"], "properties": {"timestamps": {"properties": {"mode": {"const": "source_all"}}}}}},
          {"if": {"required": ["frame_selection"], "properties": {"frame_selection": {"required": ["mode"], "properties": {"mode": {"const": "live_drop_only"}}}}}, "then": {"required": ["timestamps", "intra"]}},
          {"not": {"required": ["timestamps", "encoder", "encoder_profile"], "properties": {"encoder": {"const": "libvvenc"}, "encoder_profile": {"const": "reference"}, "timestamps": {"required": ["mode"], "properties": {"mode": {"const": "source_all"}}}}}}
        ]
      },
      "OutputConfig": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "output"
        ],
        "description": "Fixed startup branch. Unique ASCII id and destination. Other media fields inherit top-level defaults; top-level output/watermark are forbidden with outputs. Width/height pair and area <=4096*2160; zero uses first decoded canvas then freezes it. Encoder threads across branches sum <=16. Decoder is shared. Temporary queue fullness uses one shared 100ms pressure window after offering to all healthy branches; later healthy items can wait during that window. Only a timely drain strictly below all half-water marks resets it (capacity 1/2 must empty). Sustained pressure or I/O deadline fails only this branch; no destination reopen or compressed-packet dropping. Producer retains at most one pending item per branch outside queue metrics, each within single-item byte/media limits; video_items (alias queue_items) and audio_packets independently bound one FIFO; queue plus pending conservatively <=video_items+audio_packets+1, 2*queue_bytes and 2*queue_media_ms. queue_media_ms charges nominal video work duration, not PTS gaps. inflight_bytes reserves retained source plus encoder-input buffers through actual mux, max 128 frames; not an RSS bound. Codec internals, watermark assets/canvases and bounded mux/deferred audio have separate caps.",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 32,
            "pattern": "^[A-Za-z0-9_-]+$"
          },
          "output": {
            "$ref": "#/components/schemas/JobConfig/properties/output"
          },
          "output_format": {
            "$ref": "#/components/schemas/JobConfig/properties/output_format"
          },
          "encoder": {
            "$ref": "#/components/schemas/JobConfig/properties/encoder"
          },
          "encoder_preset": {
            "$ref": "#/components/schemas/JobConfig/properties/encoder_preset"
          },
          "encoder_profile": {
            "$ref": "#/components/schemas/JobConfig/properties/encoder_profile"
          },
          "width": {
            "$ref": "#/components/schemas/JobConfig/properties/width"
          },
          "height": {
            "$ref": "#/components/schemas/JobConfig/properties/height"
          },
          "bitrate": {
            "$ref": "#/components/schemas/JobConfig/properties/bitrate"
          },
          "encoder_threads": {
            "$ref": "#/components/schemas/JobConfig/properties/encoder_threads"
          },
          "audio_copy": {
            "$ref": "#/components/schemas/JobConfig/properties/audio_copy"
          },
          "mux_wait_ms": {
            "$ref": "#/components/schemas/JobConfig/properties/mux_wait_ms"
          },
          "watermark": {
            "$ref": "#/components/schemas/JobConfig/properties/watermark"
          },
          "sei": {"$ref": "#/components/schemas/SeiPolicy"},
          "queue_items": {
            "type": "integer",
            "minimum": 1,
            "maximum": 16,
            "default": 16,
            "description": "Compatibility spelling of video_items; cannot be combined with video_items. Audio has its own quota."
          },
          "video_items": {"type": "integer", "minimum": 1, "maximum": 16, "default": 16},
          "audio_packets": {"type": "integer", "minimum": 1, "maximum": 256, "default": 256},
          "queue_bytes": {
            "type": "integer",
            "minimum": 4096,
            "maximum": 268435456,
            "default": 134217728
          },
          "queue_media_ms": {
            "type": "integer",
            "minimum": 1,
            "maximum": 30000,
            "default": 5000
          },
          "max_lag_ms": {
            "type": "integer",
            "minimum": 100,
            "maximum": 30000,
            "default": 10000
          },
          "io_timeout_ms": {
            "type": "integer",
            "minimum": 100,
            "maximum": 10000,
            "default": 5000
          },
          "inflight_bytes": {
            "type": "integer",
            "minimum": 1048576,
            "maximum": 1073741824,
            "default": 536870912
          }
        }
      },
      "SeiPolicy": {
        "type": "object", "additionalProperties": false, "required": ["types"],
        "properties": {"types": {"type": "array", "maxItems": 64, "uniqueItems": true, "items": {"oneOf": [{"const": "uuid"}, {"type": "integer", "minimum": 0, "maximum": 65535}]}}},
        "description": "Explicit opaque type/payload preservation; uuid aliases numeric type 5 without UUID layout validation. Alias/numeric duplicates are rejected. Omission or an empty list disables preservation. Root list is inherited by each output; branch sei replaces the whole list. Selected pictures are protected from overload dropping. H.264/HEVC input to H.264/VVC output is reframed with unchanged type and payload. Complete single-picture single-layer AUs only; up to 64 selected messages and 65536 payload bytes per input AU across the output union. Overflow, malformed outer framing, unsupported AU association or missing decoded mapping fails explicitly. No payload semantics, HDR/geometry adjustment or hot updates. See sei.md."
      },
      "VideoRate": {
        "type": "object", "description": "Resolved startup nominal rational rate; source PTS cadence is unchanged. See video-rate.md.",
        "properties": {
          "num": {"type": "integer", "minimum": 1}, "den": {"type": "integer", "minimum": 1},
          "source": {"enum": ["av_guess_frame_rate", "config_fallback"]}, "fallback_fps": {"type": "integer", "minimum": 1, "maximum": 240},
          "nominal_frame_work_us": {"type": "integer", "minimum": 1}, "nominal_gop_frames": {"type": "integer", "minimum": 1},
