{
  "input": "rtmp://source.example/live/input",
  "output": "rtmp://receiver.example/live/output",
  "output_format": "flv",
  "encoder": "libvvenc",
  "encoder_profile": "live_3b_2s",
  "encoder_preset": "faster",
  "encoder_threads": 8,
  "width": 960,
  "height": 540,
  "output_fps": 30,
  "rate_control": "cqf",
  "qp": 32,
  "maxrate": 1100000,
  "timestamps": {"mode": "source_all"},
  "intra": {"mode": "follow_source"},
  "audio_copy": true,
  "mux_wait_ms": 50,
  "frame_log": false,
  "network_trace": true,
  "encoder_max_future_frames": 4,
  "rtmp_tcp_nodelay": true,
  "queue_capacity": 1,
  "max_threads": 2,
  "min_threads": 1,
  "budget_slots": 2
}
