# Illustrative isolation budget only: measure and replace on the target host.
# No throughput, latency, RSS or production-readiness claim is attached.
NAKI_CPU_LIMIT=4
NAKI_MEMORY_LIMIT=2g
NAKI_PID_LIMIT=256
NAKI_NOFILE_SOFT=65536
NAKI_NOFILE_HARD=65536
# Without an explicit CPU/memory setting compose preserves its prior unbounded
# CPU/memory behavior (0); PID/FD bounds above remain separate controls.
