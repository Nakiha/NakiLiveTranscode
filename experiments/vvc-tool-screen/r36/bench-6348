#!/usr/bin/env python3
"""Paired R35 / R36 RC1 single-worker service benchmark for Linux x86-64-v3."""
import argparse
import hashlib
import json
import os
from pathlib import Path
import platform
import statistics
import subprocess
import sys

ROOT = Path(__file__).resolve().parent
sys.dont_write_bytecode = True
sys.path.insert(0, str(ROOT / 'bench'))
import service_case


def lane_for(allowed, requested):
    cores = {}
    for cpu in sorted(allowed):
        topology = Path(f'/sys/devices/system/cpu/cpu{cpu}/topology')
        socket = int((topology/'physical_package_id').read_text())
        core = int((topology/'core_id').read_text())
        cores.setdefault(socket, {}).setdefault(core, cpu)
    for socket, members in sorted(cores.items()):
        if len(members) >= 8 and (requested is None or requested == socket):
            return socket, ','.join(map(str, sorted(members.values())[:8]))
    raise ValueError('Select eight available physical cores on the same socket')


def payload_hash(mp4):
    probe = ROOT/'bench/ffprobe'
    data = subprocess.check_output([probe,'-v','error','-select_streams','v:0','-show_packets',
                                    '-show_data_hash','sha256','-show_entries','packet=data_hash',
                                    '-of','csv=p=0',mp4], env=dict(os.environ, LD_LIBRARY_PATH=str(ROOT/'lib')))
    rows = data.splitlines()
    if len(rows) != 180 or any(not h.startswith(b'SHA256:') for h in rows):
        raise ValueError('Incomplete muxed access-unit hashes')
    return hashlib.sha256(data).hexdigest()


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument('--output', required=True, type=Path, help='new local results directory')
    parser.add_argument('--pairs', type=int, choices=range(1, 11), default=2, metavar='1..10')
    parser.add_argument('--socket', type=int, help='use eight cores on this CPU socket')
    parser.add_argument('--cross', action='store_true', help='both profiles x clips 11/13 x 4/8 slots')
    parser.add_argument('--case', action='append', choices=[f'{t}-{c}-p{s}' for t in ('live','quality')
                        for c in ('11','13') for s in (4,8)], help='repeat to select specific cases')
    args = parser.parse_args()
    if not __debug__: parser.error('Run without Python optimization, which disables service assertions')
    if args.case and args.cross: parser.error('Choose either --case or --cross')
    if args.case and len(set(args.case)) != len(args.case): parser.error('Duplicate --case')
    cases = args.case or ([f'{t}-{c}-p{s}' for t in ('live','quality') for c in ('11','13') for s in (4,8)]
                          if args.cross else ['live-11-p4','quality-13-p8'])
    socket, lane = lane_for(os.sched_getaffinity(0), args.socket)
    hashes = json.loads((ROOT/'bench/inputs.json').read_text())
    release = json.loads((ROOT/'release.json').read_text())
    for name, expected in {**hashes, **{k:v['sha256'] for k,v in release['modules'].items()}}.items():
        if service_case.sha(ROOT/name) != expected:
            raise ValueError(f'Package input hash mismatch for {name}')
    out = args.output.resolve()
    out.mkdir(parents=True, exist_ok=False)
    service_case.setup(ROOT)
    service_case.save(out/'host.json', dict(platform=platform.platform(), cpuinfo=Path('/proc/cpuinfo').read_text().split('\n\n')[0],
                      socket=socket, lane=lane, threads=8, frames=180, pace_fps=30, cases=cases, pairs=args.pairs,
                      runtime_key=release['runtime_dependency_key'], baseline=release['baseline'], candidate=release['vvenc']))
    summaries = []
    for name in cases:
        tier, clip, slot = name.split('-')
        slots = int(slot[1:])
        pairs = []
        for pair in range(args.pairs):
            order = ('r35','r36') if pair % 2 == 0 else ('r36','r35')
            rows = {}
            schedules = {}
            for arm in order:
                folder = out/name/f'pair-{pair+1}'/arm
                row = service_case.run_one(folder, arm, tier, clip, slots, 8, lane, True, pair)
                row['mux_payload_sha256'] = payload_hash(row['mp4_path'])
                service_case.save(folder/'result.json', row)
                rows[arm] = row
                frame_log = json.loads((folder/'frames.json').read_text())
                schedules[arm] = {frame['input_sequence']:frame['rc_qp'] for frame in frame_log}
            if schedules['r35'].keys() != schedules['r36'].keys():
                raise ValueError('The paired jobs completed different input frames')
            a,b = rows['r35'],rows['r36']
            entry = dict(order=order,worker_cpu_delta_pct=100*(b['worker_cpu_ms_per_frame']/a['worker_cpu_ms_per_frame']-1),
                         steady_p95_delta_ms=b['steady_i2m_ms']['p95']-a['steady_i2m_ms']['p95'],
                         video_bytes_delta_pct=100*(b['actual_kbps']/a['actual_kbps']-1),
                         differing_requested_qp_frames=sum(qp != schedules['r36'][frame]
                                                           for frame, qp in schedules['r35'].items()),
                         identical_mux_payload=a['mux_payload_sha256']==b['mux_payload_sha256'])
            pairs.append(entry)
        summary = dict(case=name,pairs=pairs,medians={key:statistics.median(p[key] for p in pairs)
                       for key in ('worker_cpu_delta_pct','steady_p95_delta_ms','video_bytes_delta_pct')})
        summaries.append(summary)
        service_case.save(out/'paired.json', summaries)
        print(name, json.dumps(summary['medians']), flush=True)


if __name__ == '__main__':
    main()
